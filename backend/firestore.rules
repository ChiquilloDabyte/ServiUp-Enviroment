rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }

    function requestFor(requestId) {
      return get(
        /databases/$(database)/documents/service_requests/$(requestId)
      ).data;
    }

    function chatFor(chatId) {
      return get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data;
    }

    function isChatParticipant(chat) {
      return isSignedIn() && (
        chat.clientId == request.auth.uid ||
        chat.providerId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email',
          'role',
          'name',
          'phone',
          'photoUrl',
          'location',
          'serviceCategories',
          'rating',
          'ratingCount',
          'profileComplete',
          'fcmToken',
          'createdAt'
        ])
        && request.resource.data.role in ['client', 'provider']
        && request.resource.data.name == ''
        && request.resource.data.phone == ''
        && request.resource.data.serviceCategories.size() == 0
        && request.resource.data.rating == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.profileComplete == false
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'photoUrl',
          'location',
          'serviceCategories',
          'profileComplete',
          'fcmToken',
          'updatedAt'
        ])
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fcmToken']) &&
            (
              !request.resource.data.keys().hasAny(['fcmToken']) ||
              (
                request.resource.data.fcmToken is string &&
                request.resource.data.fcmToken.size() <= 4096
              )
            )
          ) ||
          (
            request.resource.data.role == resource.data.role &&
            request.resource.data.rating == resource.data.rating &&
            request.resource.data.ratingCount == resource.data.ratingCount &&
            (
              !request.resource.data.profileComplete ||
              (
                request.resource.data.name is string &&
                request.resource.data.name.size() > 0 &&
                request.resource.data.phone is string &&
                request.resource.data.phone.size() > 0 &&
                (
                  request.resource.data.role != 'provider' ||
                  request.resource.data.serviceCategories.size() > 0
                )
              )
            )
          )
        );
      allow delete: if false;
    }

    match /provider_public_profiles/{providerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /open_request_listings/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        (
          hasRole('provider') &&
          (
            resource.data.status == 'open' ||
            resource.data.acceptedProviderId == request.auth.uid
          )
        )
      );
      allow write: if false;
    }

    match /service_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.acceptedProviderId == request.auth.uid
      );
      allow create: if hasRole('client')
        && request.resource.data.keys().hasOnly([
          'clientId',
          'category',
          'description',
          'location',
          'address',
          'scheduledAt',
          'status',
          'acceptedProviderId',
          'acceptedOfferId',
          'price',
          'createdAt'
        ])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.location is latlng
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.status == 'open'
        && request.resource.data.acceptedProviderId == null
        && request.resource.data.acceptedOfferId == null
        && request.resource.data.price == null
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /offers/{offerId} {
      allow read: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        requestFor(resource.data.requestId).clientId == request.auth.uid ||
        (
          resource.data.chatId is string &&
          isChatParticipant(chatFor(resource.data.chatId))
        )
      );
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant(resource.data);
      allow create, delete: if false;
      allow update: if isChatParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'updatedAt',
          'unreadByClient',
          'unreadByProvider'
        ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.status == resource.data.status;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatFor(chatId));
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'senderId',
            'type',
            'text',
            'imageUrl',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && isChatParticipant(chatFor(chatId))
          && chatFor(chatId).status == 'active'
          && requestFor(chatFor(chatId).requestId).status in [
            'open',
            'accepted',
            'in_progress',
            'pending_confirmation'
          ]
          && (
            (
              request.resource.data.type == 'text' &&
              request.resource.data.text is string &&
              request.resource.data.text.size() > 0 &&
              request.resource.data.text.size() <= 2000 &&
              request.resource.data.imageUrl == null
            ) ||
            (
              request.resource.data.type == 'image' &&
              request.resource.data.text == '' &&
              request.resource.data.imageUrl is string
            )
          );
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if isSignedIn() && (
        requestFor(reviewId).clientId == request.auth.uid ||
        requestFor(reviewId).acceptedProviderId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if hasRole('client')
        && reviewId == request.resource.data.requestId
        && request.resource.data.keys().hasOnly([
          'requestId',
          'clientId',
          'providerId',
          'rating',
          'comment',
          'createdAt'
        ])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time
        && requestFor(reviewId).status == 'completed'
        && requestFor(reviewId).clientId == request.auth.uid
        && requestFor(reviewId).acceptedProviderId ==
          request.resource.data.providerId;
      allow update, delete: if false;
    }

    match /_review_events/{eventId} {
      allow read, write: if false;
    }
  }
}
